{
  "serverPort": 4500,
  "libraryPaths": [
    "./samples"
  ],
  "smootherCommand": "./bin/tstools_bitrate_smoother",
  "smootherArgs": [
    "-i",
    "{file}",
    "-o",
    "{target}",
    "-l",
    "500"
  ],
  "metadataProbeCommand": "./bin/ffprobe",
  "metadataProbeArgs": [
    "-v",
    "error",
    "-show_format",
    "-show_streams",
    "-show_programs",
    "-of",
    "json",
    "{file}"
  ],
  "mediaInfoCommand": "./bin/mediainfo",
  "collectionsDir": "./data/collections",
  "cacheDir": "./data/cache",
  "logsDir": "./data/logs",
  "defaultLoop": true,
  "defaultAutoRestart": false
}
