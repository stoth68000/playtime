{
  "serverPort": 4500,
  "libraryPaths": [
    "./samples"
  ],
  "smootherCommand": "./scripts/fake_smoother.mjs",
  "smootherArgs": [
    "--input",
    "{file}",
    "--output",
    "{target}"
  ],
  "metadataProbeCommand": "ffprobe",
  "metadataProbeArgs": [
    "-v",
    "error",
    "-show_format",
    "-show_streams",
    "-show_programs",
    "-of",
    "json",
    "{file}"
  ],
  "collectionsDir": "./data/collections",
  "cacheDir": "./data/cache",
  "logsDir": "./data/logs",
  "defaultLoop": true,
  "defaultAutoRestart": false
}
